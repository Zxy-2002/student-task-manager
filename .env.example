# Copy to .env for local development. NEVER commit .env (it is in .gitignore).
# Placeholders only. Full guide: README.md > OAuth Setup.
# Use NODE_ENV=production on the hosting platform.
NODE_ENV=development
PORT=3000

# GitHub OAuth App (Settings > Developer settings > OAuth Apps > New OAuth App)
# Dev app: Homepage http://localhost:3000, callback below. Production: https://<host>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Random 32+ chars, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated NUMERIC GitHub user ids that get the admin role
#   find yours: https://api.github.com/users/<username>  -> "id"
ADMIN_GITHUB_IDS=

# Set to 1 behind a reverse proxy (Railway/Render/Heroku) so Secure cookies work.
# Empty, 0 or false = off.
TRUST_PROXY=

# Local demo only: enables POST /auth/dev-login. Ignored when NODE_ENV=production.
DEV_LOGIN=0
